# Copy to .env for local development:  cp .env.example .env
# Every variable is validated at startup by apps/api/src/config/env.js.

NODE_ENV=development
APP_ENV=local
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info
LOG_PRETTY=true

# --- API ---
PORT=4000
TRUST_PROXY=1
REQUEST_TIMEOUT_MS=15000
BODY_LIMIT=100kb
# Used by the Next.js server to reach the API (server components, dev rewrites).
API_INTERNAL_URL=http://localhost:4000

# --- MySQL (docker-compose service "mysql") ---
DATABASE_URL=mysql://orbit_app:orbit_app_dev@localhost:3306/orbit
# Tests refuse to run unless the database name ends with _test.
DATABASE_URL_TEST=mysql://orbit_app:orbit_app_dev@localhost:3306/orbit_test
# Browser end-to-end tests (Playwright) use their own database.
DATABASE_URL_E2E=mysql://orbit_app:orbit_app_dev@localhost:3306/orbit_e2e_test
# Prisma migrate dev needs to create a temporary shadow database.
SHADOW_DATABASE_URL=mysql://root:orbit_root_dev@localhost:3306/orbit_shadow

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=orbit:

# --- Object storage (SeaweedFS locally, any S3-compatible service in production) ---
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=orbit_s3
S3_SECRET_ACCESS_KEY=orbit_s3_dev_secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_CAPTURES=orbit-captures-local
S3_BUCKET_FILES=orbit-files-local

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ---
SESSION_SECRET=change-me-dev-only-session-secret-0000000000
CSRF_SECRET=change-me-dev-only-csrf-secret-00000000000000
# Field-level encryption for sensitive profile data: kid:base64(32 bytes)[,older keys for rotation]
# Generate: node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEYS=dev1:BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_DAYS=14

# --- Email (Mailpit UI at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Orbit <no-reply@orbit.local>"

# --- Optional ---
# SENTRY_DSN=
# SEED_PASSWORD=

# --- Observability (see docs/environment.md) ---
# Internal Prometheus endpoint (GET /metrics); 0 disables it.
# METRICS_PORT=9464

# --- Web: Content-Security-Policy ---
# Object-storage origins the browser uploads to / loads images from (presigned URLs), space-separated.
CSP_STORAGE_ORIGINS=http://localhost:8333

# --- Operations jobs (docs/backup-restore.md, docs/operations.md) ---
# DATABASE_MAINTENANCE_URL=mysql://orbit_maintenance:…@localhost:3306/orbit
# S3_BUCKET_ARCHIVE=orbit-archive-local
# RETENTION_ACTIVITY_MONTHS=13
# RETENTION_AUDIT_MONTHS=24
# RETENTION_ACCESS_LOG_MONTHS=24
# RETENTION_LOGIN_ATTEMPT_MONTHS=3
# BACKUP_DATABASE_URL=mysql://orbit_backup:…@localhost:3306/orbit
# BACKUP_DIR=./backups
# BACKUP_AGE_RECIPIENT=age1…
# RESTORE_ADMIN_URL=mysql://root:…@localhost:3306/mysql
