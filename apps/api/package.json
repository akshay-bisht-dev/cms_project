{
  "name": "@orbit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.js",
    "dev:worker": "node --env-file-if-exists=../../.env --watch src/worker.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:seed": "node --env-file-if-exists=../../.env prisma/seed.js",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "test:infra": "vitest run --project infra",
    "openapi": "node --env-file-if-exists=../../.env scripts/generate-openapi.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1154.0",
    "@aws-sdk/s3-request-presigner": "3.1154.0",
    "@node-rs/argon2": "2.2.2",
    "@orbit/shared-constants": "workspace:*",
    "@orbit/validation": "workspace:*",
    "@prisma/client": "6.19.3",
    "bullmq": "6.3.19",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "luxon": "3.7.2",
    "nodemailer": "10.1.7",
    "pdfkit": "0.20.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "6.19.3",
    "prom-client": "15.1.3",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "dotenv-cli": "11.0.0",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "vitest": "5.0.5"
  }
}
