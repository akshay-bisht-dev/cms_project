  convertedClientId      String?    @map("converted_client_id") @db.Char(36)
  convertedOpportunityId String?    @map("converted_opportunity_id") @db.Char(36)
  convertedAt            DateTime?  @map("converted_at") @db.DateTime(3)
  version                Int        @default(0)
