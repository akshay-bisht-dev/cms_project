  eventId        String @map("event_id") @db.Char(36)
  userId         String @map("user_id") @db.Char(36)

  event  CalendarEvent      @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  member OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)

  @@id([eventId, userId])
  @@index([organizationId, userId])
  @@map("calendar_event_attendees")
}

// ─── Monitoring ─────────────────────────────────────────────────────────────

enum PolicyScope {
  ORG
  TEAM
  MEMBER
}

/// A capture policy. Settings live in immutable versions; publishing creates a new version.
/// Exactly one ORG policy per organization (org_singleton = 'ORG' is unique; NULL otherwise).
model CapturePolicy {
  id               String      @id @default(uuid(7)) @db.Char(36)
  organizationId   String      @map("organization_id") @db.Char(36)
  name             String      @db.VarChar(120)
  scopeLevel       PolicyScope @map("scope_level")
  orgSingleton     String?     @map("org_singleton") @db.Char(3)
  isActive         Boolean     @default(true) @map("is_active")
  currentVersionId String?     @map("current_version_id") @db.Char(36)
  createdAt        DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     MonitoringPolicyVersion[]
  assignments  CapturePolicyAssignment[]

  @@unique([organizationId, id])
  @@unique([organizationId, orgSingleton])
  @@map("capture_policies")
}

enum CaptureMode {
  ALL_SCREENS
  ACTIVE_SCREEN
}

/// Immutable once published: every screenshot records the version that governed it.
model MonitoringPolicyVersion {
  id                   String      @id @default(uuid(7)) @db.Char(36)
  organizationId       String      @map("organization_id") @db.Char(36)
  policyId             String      @map("policy_id") @db.Char(36)
  versionNo            Int         @map("version_no")
  captureEnabled       Boolean     @map("capture_enabled")
  intervalS            Int         @map("interval_s")
  minIntervalS         Int         @map("min_interval_s")
  maxIntervalS         Int         @map("max_interval_s")
  blur                 Boolean     @default(false)
  captureMode          CaptureMode @default(ACTIVE_SCREEN) @map("capture_mode")
  excludedApps         Json        @map("excluded_apps")
  idleDetectionEnabled Boolean     @default(false) @map("idle_detection_enabled")
  retentionDays        Int         @map("retention_days")
  noticeText           String      @map("notice_text") @db.Text
  noticeHash           String      @map("notice_hash") @db.Char(64)
  publishedById        String      @map("published_by_id") @db.Char(36)
  publishedAt          DateTime    @default(now()) @map("published_at") @db.DateTime(3)

  policy      CapturePolicy             @relation(fields: [organizationId, policyId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  consents    MonitoringConsentRecord[]
  screenshots Screenshot[]

  @@unique([organizationId, id])
  @@unique([policyId, versionNo])
  @@map("monitoring_policy_versions")
}

enum PolicyTarget {
  TEAM
  MEMBER
}

model CapturePolicyAssignment {
  id             String       @id @default(uuid(7)) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  policyId       String       @map("policy_id") @db.Char(36)
  targetType     PolicyTarget @map("target_type")
  targetId       String       @map("target_id") @db.Char(36)
  priority       Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  policy CapturePolicy @relation(fields: [organizationId, policyId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([organizationId, targetType, targetId, policyId])
  @@index([organizationId, targetType, targetId])
  @@map("capture_policy_assignments")
}

enum ConsentAction {
  ACKNOWLEDGED
  WITHDRAWN
}

/// Append-only record of notice acknowledgements and withdrawals.
model MonitoringConsentRecord {
  id              String        @id @default(uuid(7)) @db.Char(36)
  organizationId  String        @map("organization_id") @db.Char(36)
  userId          String        @map("user_id") @db.Char(36)
  policyVersionId String        @map("policy_version_id") @db.Char(36)
  action          ConsentAction
  noticeHash      String        @map("notice_hash") @db.Char(64)
  ip              String?       @db.VarChar(45)
  userAgent       String?       @map("user_agent") @db.VarChar(512)
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  member        OrganizationMember      @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)
  policyVersion MonitoringPolicyVersion @relation(fields: [organizationId, policyVersionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, userId, createdAt])
  @@map("monitoring_consent_records")
}

/// One-time codes (5 minutes) that pair a desktop agent with the signed-in member.
model AgentPairingCode {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  userId         String    @map("user_id") @db.Char(36)
  codeHash       String    @unique @map("code_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at") @db.DateTime(3)
  usedAt         DateTime? @map("used_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  member OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)

  @@map("agent_pairing_codes")
}

enum AgentStatus {
  ACTIVE
  REVOKED
}

/// A registered desktop agent. Its Ed25519 private key stays on the device; the public key
/// verifies challenge signatures when it asks for a short-lived access token.
model DesktopAgent {
  id             String      @id @default(uuid(7)) @db.Char(36)
  organizationId String      @map("organization_id") @db.Char(36)
  userId         String      @map("user_id") @db.Char(36)
  deviceName     String      @map("device_name") @db.VarChar(120)
  os             String      @db.VarChar(32)
  osVersion      String?     @map("os_version") @db.VarChar(64)
  agentVersion   String?     @map("agent_version") @db.VarChar(32)
  publicKey      String      @map("public_key") @db.VarChar(128)
  status         AgentStatus @default(ACTIVE)
  lastNonceHash  String?     @map("last_nonce_hash") @db.Char(64)
  lastSeenAt     DateTime?   @map("last_seen_at") @db.DateTime(3)
  lastState      Json?       @map("last_state")
  registeredAt   DateTime    @default(now()) @map("registered_at") @db.DateTime(3)
  revokedAt      DateTime?   @map("revoked_at") @db.DateTime(3)
  revokedById    String?     @map("revoked_by_id") @db.Char(36)

  member      OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)
  screenshots Screenshot[]

  @@unique([organizationId, id])
  @@index([organizationId, userId, status])
  @@map("desktop_agents")
}

enum ScreenshotStatus {
  PENDING_UPLOAD
  UPLOADED
  READY
  FAILED
  REJECTED
  DELETED
}

/// Screenshot metadata. The image lives in private object storage, never in MySQL.
model Screenshot {
  id                 String           @id @default(uuid(7)) @db.Char(36)
  organizationId     String           @map("organization_id") @db.Char(36)
  userId             String           @map("user_id") @db.Char(36)
  agentId            String           @map("agent_id") @db.Char(36)
  workSessionId      String?          @map("work_session_id") @db.Char(36)
  projectId          String?          @map("project_id") @db.Char(36)
  taskId             String?          @map("task_id") @db.Char(36)
  policyVersionId    String           @map("policy_version_id") @db.Char(36)
  clientCaptureId    String           @map("client_capture_id") @db.Char(36)
  capturedAt         DateTime         @map("captured_at") @db.DateTime(3)
  uploadedAt         DateTime?        @map("uploaded_at") @db.DateTime(3)
  storageKey         String?          @map("storage_key") @db.VarChar(300)
  thumbKey           String?          @map("thumb_key") @db.VarChar(300)
  mimeType           String?          @map("mime_type") @db.VarChar(32)
  width              Int?
  height             Int?
  sizeBytes          Int?             @map("size_bytes")
  sha256             String?          @db.VarChar(64)
  status             ScreenshotStatus @default(PENDING_UPLOAD)
  failureCode        String?          @map("failure_code") @db.VarChar(48)
  retentionExpiresAt DateTime?        @map("retention_expires_at") @db.DateTime(3)
  legalHold          Boolean          @default(false) @map("legal_hold")
  deletedAt          DateTime?        @map("deleted_at") @db.DateTime(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  member        OrganizationMember      @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  agent         DesktopAgent            @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  policyVersion MonitoringPolicyVersion @relation(fields: [organizationId, policyVersionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, agentId, clientCaptureId])
  @@index([organizationId, userId, capturedAt])
  @@index([organizationId, projectId, capturedAt])
  @@index([status, retentionExpiresAt])
  @@index([status, createdAt])
  @@map("screenshots")
}

/// Who viewed or downloaded which screenshot. Append-only, no foreign keys, timestamp in the
/// primary key so it can be partitioned by month (ADR D13).
model ScreenshotAccessLog {
  id             String   @default(uuid(7)) @db.Char(36)
  at             DateTime @default(now()) @db.DateTime(3)
  organizationId String   @map("organization_id") @db.Char(36)
  screenshotId   String   @map("screenshot_id") @db.Char(36)
  actorId        String   @map("actor_id") @db.Char(36)
  action         String   @db.VarChar(16)
  ip             String?  @db.VarChar(45)

  @@id([id, at])
  @@index([organizationId, screenshotId, at])
  @@index([organizationId, actorId, at])
  @@map("screenshot_access_logs")
}

model ScreenshotDeletionLog {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  screenshotId   String   @map("screenshot_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  capturedAt     DateTime @map("captured_at") @db.DateTime(3)
  actorId        String?  @map("actor_id") @db.Char(36)
  reason         String   @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([organizationId, createdAt])
  @@map("screenshot_deletion_logs")
}

model LegalHold {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  name           String    @db.VarChar(120)
  reason         String    @db.VarChar(1000)
  createdById    String    @map("created_by_id") @db.Char(36)
  releasedAt     DateTime? @map("released_at") @db.DateTime(3)
  releasedById   String?   @map("released_by_id") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  targets LegalHoldTarget[]

  @@unique([organizationId, id])
  @@map("legal_holds")
}

enum HoldTarget {
  MEMBER
  PROJECT
}

model LegalHoldTarget {
  id             String     @id @default(uuid(7)) @db.Char(36)
  organizationId String     @map("organization_id") @db.Char(36)
  holdId         String     @map("hold_id") @db.Char(36)
  targetType     HoldTarget @map("target_type")
  targetId       String     @map("target_id") @db.Char(36)
  fromDate       DateTime?  @map("from_date") @db.Date
  toDate         DateTime?  @map("to_date") @db.Date

  hold LegalHold @relation(fields: [organizationId, holdId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId, targetType, targetId])
  @@map("legal_hold_targets")
}

// ─── Activity & reports ─────────────────────────────────────────────────────

/// Append-only record of what happened (who, what, when). No foreign keys and the timestamp is
/// part of the primary key, so the table can be partitioned by month (ADR D13).
model ActivityEvent {
  id             String   @default(uuid(7)) @db.Char(36)
  occurredAt     DateTime @map("occurred_at") @db.DateTime(3)
  organizationId String   @map("organization_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  type           String   @db.VarChar(48)
  subjectType    String?  @map("subject_type") @db.VarChar(32)
  subjectId      String?  @map("subject_id") @db.Char(36)
  projectId      String?  @map("project_id") @db.Char(36)
  /// For interval events (e.g. idle): seconds the interval lasted, starting at occurred_at.
  durationS      Int?     @map("duration_s")
  metadata       Json?

  @@id([id, occurredAt])
  @@index([organizationId, userId, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("activity_events")
}

/// One row per member per local day, rebuilt from source tables by the rollup job.
/// Drives dashboards, insights and reports; never edited by hand.
model DailyMemberStat {
  organizationId      String   @map("organization_id") @db.Char(36)
  userId              String   @map("user_id") @db.Char(36)
  date                DateTime @db.Date
  timeZone            String   @map("time_zone") @db.VarChar(64)
  /// PRESENT | ABSENT | HOLIDAY | NONE (nothing scheduled, nothing worked)
  status              String   @db.VarChar(12)
  scheduledS          Int      @default(0) @map("scheduled_s")
  workedS             Int      @default(0) @map("worked_s")
  breakS              Int      @default(0) @map("break_s")
  lateByS             Int      @default(0) @map("late_by_s")
  overtimeS           Int      @default(0) @map("overtime_s")
  trackedS            Int      @default(0) @map("tracked_s")
  billableS           Int      @default(0) @map("billable_s")
  idleS               Int      @default(0) @map("idle_s")
  monitoredS          Int      @default(0) @map("monitored_s")
  screenshotsExpected Int      @default(0) @map("screenshots_expected")
  screenshotsOk       Int      @default(0) @map("screenshots_ok")
  screenshotsFailed   Int      @default(0) @map("screenshots_failed")
  tasksCompleted      Int      @default(0) @map("tasks_completed")
  computedAt          DateTime @map("computed_at") @db.DateTime(3)

  member OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)

  @@id([organizationId, userId, date])
  @@index([organizationId, date])
  @@map("daily_member_stats")
}

/// Days whose stats must be rebuilt. `date` is a UTC calendar date; the rollup recomputes every
/// local date it overlaps in the member's zone.
model StatsDirtyDay {
  organizationId String   @map("organization_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  date           DateTime @db.Date
  markedAt       DateTime @default(now()) @map("marked_at") @db.DateTime(3)

  @@id([organizationId, userId, date])
  @@index([markedAt])
  @@map("stats_dirty_days")
}

enum ReportJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  EXPIRED
}

model ReportJob {
  id             String          @id @default(uuid(7)) @db.Char(36)
  organizationId String          @map("organization_id") @db.Char(36)
  requestedById  String          @map("requested_by_id") @db.Char(36)
  type           String          @db.VarChar(48)
  format         String          @db.VarChar(8)
  params         Json
  status         ReportJobStatus @default(QUEUED)
  rowCount       Int?            @map("row_count")
  storageKey     String?         @map("storage_key") @db.VarChar(300)
  fileName       String?         @map("file_name") @db.VarChar(200)
  sizeBytes      Int?            @map("size_bytes")
  error          String?         @db.VarChar(500)
  startedAt      DateTime?       @map("started_at") @db.DateTime(3)
  finishedAt     DateTime?       @map("finished_at") @db.DateTime(3)
  expiresAt      DateTime?       @map("expires_at") @db.DateTime(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  member OrganizationMember @relation(fields: [organizationId, requestedById], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, requestedById, createdAt])
  @@index([status, expiresAt])
  @@map("report_jobs")
}

// ─── CRM ────────────────────────────────────────────────────────────────────

/// Per-organization counters for human-readable numbers (tickets, quotes, invoices).
/// Incremented under SELECT … FOR UPDATE, so numbers are gap-free per committed transaction.
model DocumentSequence {
  organizationId String @map("organization_id") @db.Char(36)
  name           String @db.VarChar(16)
  nextValue      Int    @default(1) @map("next_value")

  @@id([organizationId, name])
  @@map("document_sequences")
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

model Client {
  id               String       @id @default(uuid(7)) @db.Char(36)
  organizationId   String       @map("organization_id") @db.Char(36)
  code             String       @db.VarChar(32)
  name             String       @db.VarChar(200)
  industry         String?      @db.VarChar(80)
  sizeBand         String?      @map("size_band") @db.VarChar(16)
  website          String?      @db.VarChar(255)
  email            String?      @db.VarChar(254)
  phone            String?      @db.VarChar(40)
  address          Json?
  country          String?      @db.Char(2)
  taxId            String?      @map("tax_id") @db.VarChar(64)
  accountManagerId String?      @map("account_manager_id") @db.Char(36)
  status           ClientStatus @default(PROSPECT)
  defaultCurrency  String       @map("default_currency") @db.Char(3)
  paymentTermsDays Int          @default(30) @map("payment_terms_days") @db.SmallInt
  archivedAt       DateTime?    @map("archived_at") @db.DateTime(3)
  version          Int          @default(0)
  createdAt        DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  contacts      ClientContact[]
  notes         ClientNote[]
  projects      Project[]
  opportunities Opportunity[]
  tickets       SupportTicket[]
  quotes        Quote[]
  agreements    ServiceAgreement[]
  invoices      Invoice[]
  portalUsers   OrganizationMember[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status, archivedAt])
  @@index([organizationId, name])
  @@map("clients")
}

model ClientContact {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  clientId       String    @map("client_id") @db.Char(36)
  name           String    @db.VarChar(160)
  email          String?   @db.VarChar(254)
  phone          String?   @db.VarChar(40)
  title          String?   @db.VarChar(120)
  isPrimary      Boolean   @default(false) @map("is_primary")
  archivedAt     DateTime? @map("archived_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  client Client @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, clientId])
  @@map("client_contacts")
}

enum CommunicationKind {
  NOTE
  CALL
  EMAIL
  MEETING
}

/// Communication history with a client.
model ClientNote {
  id             String            @id @default(uuid(7)) @db.Char(36)
  organizationId String            @map("organization_id") @db.Char(36)
  clientId       String            @map("client_id") @db.Char(36)
  kind           CommunicationKind @default(NOTE)
  body           String            @db.Text
  occurredAt     DateTime          @map("occurred_at") @db.DateTime(3)
  authorId       String            @map("author_id") @db.Char(36)
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  client Client @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId, clientId, occurredAt])
  @@map("client_notes")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

model Lead {
  id                     String     @id @default(uuid(7)) @db.Char(36)
  organizationId         String     @map("organization_id") @db.Char(36)
  name                   String     @db.VarChar(160)
  company                String?    @db.VarChar(200)
  email                  String?    @db.VarChar(254)
  phone                  String?    @db.VarChar(40)
  source                 String?    @db.VarChar(48)
  ownerId                String?    @map("owner_id") @db.Char(36)
  status                 LeadStatus @default(NEW)
  score                  Int?       @db.SmallInt
  followUpAt             DateTime?  @map("follow_up_at") @db.DateTime(3)
  lostReason             String?    @map("lost_reason") @db.VarChar(500)
  notes                  String?    @db.Text
  estimatedValue         Decimal?   @map("estimated_value") @db.Decimal(19, 4)
