  reporter  OrganizationMember @relation("TicketReporter", fields: [organizationId, reporterId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  slaPolicy SlaPolicy?         @relation(fields: [organizationId, slaPolicyId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  comments  TicketComment[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status, priority])
  @@index([organizationId, resolutionDueAt])
  @@index([organizationId, clientId, createdAt])
