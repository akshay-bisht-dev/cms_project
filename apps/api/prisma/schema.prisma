  taxAmount      Decimal @map("tax_amount") @db.Decimal(19, 4)

  quote Quote @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId, quoteId])
  @@map("quote_items")
}

// ─── Finance ────────────────────────────────────────────────────────────────

/// 1 unit of `currency` = rate_to_base units of the organization's base currency.
model ExchangeRate {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  currency       String   @db.Char(3)
  rateToBase     Decimal  @map("rate_to_base") @db.Decimal(19, 8)
  effectiveFrom  DateTime @map("effective_from") @db.Date
  createdById    String   @map("created_by_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([organizationId, currency, effectiveFrom])
  @@map("exchange_rates")
}

enum RateKind {
  BILL
  COST
}

enum RateTarget {
  ORG
  MEMBER
  CLIENT
  PROJECT
  PROJECT_MEMBER
}

/// Hourly rates. Billing precedence: project-member > project > client > member > organization.
/// Cost rates (what a person costs) use MEMBER or ORG and are visible only with finance.cost.read.
model BillingRate {
  id             String     @id @default(uuid(7)) @db.Char(36)
  organizationId String     @map("organization_id") @db.Char(36)
  kind           RateKind
  targetType     RateTarget @map("target_type")
  targetId       String?    @map("target_id") @db.Char(36)
  projectId      String?    @map("project_id") @db.Char(36)
  amount         Decimal    @db.Decimal(19, 4)
  currency       String     @db.Char(3)
  effectiveFrom  DateTime   @map("effective_from") @db.Date
  effectiveTo    DateTime?  @map("effective_to") @db.Date
  createdAt      DateTime   @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, kind, targetType, targetId, effectiveFrom])
  @@map("billing_rates")
}

model ExpenseCategory {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  name           String    @db.VarChar(80)
  archivedAt     DateTime? @map("archived_at") @db.DateTime(3)

  expenses Expense[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("expense_categories")
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

model Expense {
  id              String        @id @default(uuid(7)) @db.Char(36)
  organizationId  String        @map("organization_id") @db.Char(36)
  userId          String        @map("user_id") @db.Char(36)
  projectId       String?       @map("project_id") @db.Char(36)
  clientId        String?       @map("client_id") @db.Char(36)
  categoryId      String?       @map("category_id") @db.Char(36)
  description     String        @db.VarChar(500)
  amount          Decimal       @db.Decimal(19, 4)
  currency        String        @db.Char(3)
  incurredOn      DateTime      @map("incurred_on") @db.Date
  isBillable      Boolean       @default(false) @map("is_billable")
  receiptFileId   String?       @map("receipt_file_id") @db.Char(36)
  status          ExpenseStatus @default(DRAFT)
  submittedAt     DateTime?     @map("submitted_at") @db.DateTime(3)
  decidedAt       DateTime?     @map("decided_at") @db.DateTime(3)
  decidedById     String?       @map("decided_by_id") @db.Char(36)
  decisionComment String?       @map("decision_comment") @db.VarChar(500)
  reimbursedAt    DateTime?     @map("reimbursed_at") @db.DateTime(3)
  version         Int           @default(0)
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  member   OrganizationMember  @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  category ExpenseCategory?    @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  receipt  FileObject?         @relation(fields: [organizationId, receiptFileId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  invoiced InvoiceItemExpense?
  task     Task?               @relation(fields: [taskId], references: [id])
  taskId   String?             @db.Char(36)

  @@unique([organizationId, id])
  @@index([organizationId, userId, incurredOn])
  @@index([organizationId, projectId, incurredOn])
  @@index([organizationId, status])
  @@map("expenses")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

/// Status is derived from payment records: an invoice becomes PAID only when the sum of its
/// payments covers the total (also enforced by a CHECK constraint on amount_paid).
model Invoice {
  id             String        @id @default(uuid(7)) @db.Char(36)
  organizationId String        @map("organization_id") @db.Char(36)
  clientId       String        @map("client_id") @db.Char(36)
  projectId      String?       @map("project_id") @db.Char(36)
  number         String?       @db.VarChar(32)
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime?     @map("issue_date") @db.Date
  dueDate        DateTime?     @map("due_date") @db.Date
  currency       String        @db.Char(3)
  subtotal       Decimal       @default(0) @db.Decimal(19, 4)
  taxTotal       Decimal       @default(0) @map("tax_total") @db.Decimal(19, 4)
  total          Decimal       @default(0) @db.Decimal(19, 4)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(19, 4)
  notes          String?       @db.Text
  issuedById     String?       @map("issued_by_id") @db.Char(36)
  voidedAt       DateTime?     @map("voided_at") @db.DateTime(3)
  voidReason     String?       @map("void_reason") @db.VarChar(500)
  createdById    String        @map("created_by_id") @db.Char(36)
  version        Int           @default(0)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  client   Client          @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  items    InvoiceItem[]
  payments PaymentRecord[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, clientId, issueDate])
  @@map("invoices")
}

enum InvoiceItemKind {
  TIME
  EXPENSE
  MANUAL
}

model InvoiceItem {
  id             String          @id @default(uuid(7)) @db.Char(36)
  organizationId String          @map("organization_id") @db.Char(36)
  invoiceId      String          @map("invoice_id") @db.Char(36)
  kind           InvoiceItemKind
  sortOrder      Int             @map("sort_order")
  description    String          @db.VarChar(500)
  quantity       Decimal         @db.Decimal(12, 4)
  unitPrice      Decimal         @map("unit_price") @db.Decimal(19, 4)
  taxRate        Decimal         @map("tax_rate") @db.Decimal(6, 4)
  lineTotal      Decimal         @map("line_total") @db.Decimal(19, 4)
  taxAmount      Decimal         @map("tax_amount") @db.Decimal(19, 4)
  projectId      String?         @map("project_id") @db.Char(36)

  invoice     Invoice                @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  timeEntries InvoiceItemTimeEntry[]
  expenses    InvoiceItemExpense[]

  @@unique([organizationId, id])
  @@index([organizationId, invoiceId])
  @@map("invoice_items")
}

/// A time entry can be on at most one (non-void) invoice: UNIQUE(organization_id, time_entry_id).
model InvoiceItemTimeEntry {
  id             String @id @default(uuid(7)) @db.Char(36)
  organizationId String @map("organization_id") @db.Char(36)
  invoiceItemId  String @map("invoice_item_id") @db.Char(36)
  timeEntryId    String @map("time_entry_id") @db.Char(36)

  item      InvoiceItem @relation(fields: [organizationId, invoiceItemId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  timeEntry TimeEntry   @relation(fields: [organizationId, timeEntryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, timeEntryId])
  @@index([organizationId, invoiceItemId])
  @@map("invoice_item_time_entries")
}

model InvoiceItemExpense {
  id             String @id @default(uuid(7)) @db.Char(36)
  organizationId String @map("organization_id") @db.Char(36)
  invoiceItemId  String @map("invoice_item_id") @db.Char(36)
  expenseId      String @map("expense_id") @db.Char(36)

  item    InvoiceItem @relation(fields: [organizationId, invoiceItemId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  expense Expense     @relation(fields: [organizationId, expenseId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, expenseId])
  @@index([organizationId, invoiceItemId])
  @@map("invoice_item_expenses")
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  CHEQUE
  OTHER
}

/// Append-only. Corrections are recorded as refunds (negative amounts), never edits.
model PaymentRecord {
  id             String        @id @default(uuid(7)) @db.Char(36)
  organizationId String        @map("organization_id") @db.Char(36)
  invoiceId      String        @map("invoice_id") @db.Char(36)
  amount         Decimal       @db.Decimal(19, 4)
  currency       String        @db.Char(3)
  receivedOn     DateTime      @map("received_on") @db.Date
  method         PaymentMethod
  reference      String?       @db.VarChar(120)
  note           String?       @db.VarChar(500)
  recordedById   String        @map("recorded_by_id") @db.Char(36)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  invoice Invoice @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, invoiceId])
  @@index([organizationId, receivedOn])
  @@map("payment_records")
}

// ─── Leave ──────────────────────────────────────────────────────────────────

model LeaveType {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  code           String    @db.VarChar(16)
  name           String    @db.VarChar(80)
  isPaid         Boolean   @default(true) @map("is_paid")
  allowsHalfDay  Boolean   @default(true) @map("allows_half_day")
  color          String?   @db.VarChar(7)
  archivedAt     DateTime? @map("archived_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  policies LeavePolicy[]
  requests LeaveRequest[]
  ledger   LeaveLedgerEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@map("leave_types")
}

enum LeaveAccrual {
  NONE
  MONTHLY
  ANNUAL
}

/// How a leave type accrues and who approves it. The default policy of a type applies to everyone
/// without a more specific assignment (member > team > department > default).
model LeavePolicy {
  id               String       @id @default(uuid(7)) @db.Char(36)
  organizationId   String       @map("organization_id") @db.Char(36)
  leaveTypeId      String       @map("leave_type_id") @db.Char(36)
  name             String       @db.VarChar(120)
  accrual          LeaveAccrual @default(ANNUAL)
  accrualDays      Decimal      @default(0) @map("accrual_days") @db.Decimal(6, 2)
  capDays          Decimal?     @map("cap_days") @db.Decimal(6, 2)
  carryOverMaxDays Decimal?     @map("carry_over_max_days") @db.Decimal(6, 2)
  allowNegative    Boolean      @default(false) @map("allow_negative")
  /// Ordered approval steps, e.g. ["MANAGER", "HR"].
  approvalChain    Json         @map("approval_chain")
  isDefault        Boolean      @default(false) @map("is_default")
  archivedAt       DateTime?    @map("archived_at") @db.DateTime(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  leaveType   LeaveType               @relation(fields: [organizationId, leaveTypeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  assignments LeavePolicyAssignment[]

  @@unique([organizationId, id])
  @@index([organizationId, leaveTypeId])
  @@map("leave_policies")
}

enum LeavePolicyTarget {
  DEPARTMENT
  TEAM
  MEMBER
}

model LeavePolicyAssignment {
  id             String            @id @default(uuid(7)) @db.Char(36)
  organizationId String            @map("organization_id") @db.Char(36)
  policyId       String            @map("policy_id") @db.Char(36)
  targetType     LeavePolicyTarget @map("target_type")
  targetId       String            @map("target_id") @db.Char(36)
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  policy LeavePolicy @relation(fields: [organizationId, policyId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([organizationId, policyId, targetType, targetId])
  @@index([organizationId, targetType, targetId])
  @@map("leave_policy_assignments")
}

enum LeaveLedgerType {
  OPENING
  ACCRUAL
  USAGE
  REVERSAL
  ADJUSTMENT
  CARRY_OVER
  EXPIRY
}

/// The balance is the sum of this ledger (FR-LV-1): it can always be rebuilt from history.
/// Append-only; every automatic entry has an idempotency key, so jobs can safely re-run.
model LeaveLedgerEntry {
  id             String          @id @default(uuid(7)) @db.Char(36)
  organizationId String          @map("organization_id") @db.Char(36)
  userId         String          @map("user_id") @db.Char(36)
  leaveTypeId    String          @map("leave_type_id") @db.Char(36)
  entryType      LeaveLedgerType @map("entry_type")
  days           Decimal         @db.Decimal(6, 2)
  effectiveDate  DateTime        @map("effective_date") @db.Date
  leaveRequestId String?         @map("leave_request_id") @db.Char(36)
  note           String?         @db.VarChar(500)
  idempotencyKey String          @map("idempotency_key") @db.VarChar(191)
  createdById    String?         @map("created_by_id") @db.Char(36)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  member    OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  leaveType LeaveType          @relation(fields: [organizationId, leaveTypeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, userId, leaveTypeId, effectiveDate])
  @@map("leave_ledger_entries")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HalfDay {
  FULL
  AM
  PM
}

model LeaveRequest {
  id             String      @id @default(uuid(7)) @db.Char(36)
  organizationId String      @map("organization_id") @db.Char(36)
  userId         String      @map("user_id") @db.Char(36)
  leaveTypeId    String      @map("leave_type_id") @db.Char(36)
  policyId       String?     @map("policy_id") @db.Char(36)
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime    @map("end_date") @db.Date
  startHalf      HalfDay     @default(FULL) @map("start_half")
  endHalf        HalfDay     @default(FULL) @map("end_half")
  days           Decimal     @db.Decimal(6, 2)
  reason         String?     @db.VarChar(1000)
  status         LeaveStatus @default(PENDING)
  /// Approval steps resolved when the request was made: [{ rule, approverIds }].
  chain          Json
  currentStep    Int         @default(0) @map("current_step")
  decidedAt      DateTime?   @map("decided_at") @db.DateTime(3)
  version        Int         @default(0)
  createdAt      DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  member    OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  leaveType LeaveType          @relation(fields: [organizationId, leaveTypeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  approvals LeaveApproval[]

  @@unique([organizationId, id])
  @@index([organizationId, userId, startDate])
  @@index([organizationId, status])
  @@index([organizationId, startDate, endDate])
  @@map("leave_requests")
}

/// Append-only history of decisions on a leave request.
model LeaveApproval {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  leaveRequestId String   @map("leave_request_id") @db.Char(36)
  step           Int
  actorId        String   @map("actor_id") @db.Char(36)
  action         String   @db.VarChar(16)
  comment        String?  @db.VarChar(1000)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  request LeaveRequest @relation(fields: [organizationId, leaveRequestId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId, leaveRequestId, createdAt])
  @@map("leave_approvals")
}

// ─── HR ─────────────────────────────────────────────────────────────────────

enum DocumentVisibility {
  HR_ONLY
  EMPLOYEE
}

/// Employment documents in private storage (contracts, ID proofs, letters).
model EmploymentDocument {
  id             String             @id @default(uuid(7)) @db.Char(36)
  organizationId String             @map("organization_id") @db.Char(36)
  userId         String             @map("user_id") @db.Char(36)
  type           String             @db.VarChar(48)
  title          String             @db.VarChar(200)
  fileId         String             @map("file_id") @db.Char(36)
  visibility     DocumentVisibility @default(HR_ONLY)
  expiresOn      DateTime?          @map("expires_on") @db.Date
  uploadedById   String             @map("uploaded_by_id") @db.Char(36)
  archivedAt     DateTime?          @map("archived_at") @db.DateTime(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.DateTime(3)

  member OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  file   FileObject         @relation(fields: [organizationId, fileId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  task   Task?              @relation(fields: [taskId], references: [id])
  taskId String?            @db.Char(36)

  @@unique([organizationId, id])
  @@index([organizationId, userId])
  @@index([organizationId, expiresOn])
  @@map("employment_documents")
}

enum ChecklistKind {
  ONBOARDING
  OFFBOARDING
}

/// items: [{ title, assignee: "HR" | "MANAGER" | "EMPLOYEE", dueOffsetDays }]
model ChecklistTemplate {
  id             String        @id @default(uuid(7)) @db.Char(36)
  organizationId String        @map("organization_id") @db.Char(36)
  kind           ChecklistKind
  name           String        @db.VarChar(120)
  items          Json
  isDefault      Boolean       @default(false) @map("is_default")
  archivedAt     DateTime?     @map("archived_at") @db.DateTime(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([organizationId, id])
  @@map("checklist_templates")
}

model Checklist {
  id             String        @id @default(uuid(7)) @db.Char(36)
  organizationId String        @map("organization_id") @db.Char(36)
  userId         String        @map("user_id") @db.Char(36)
  kind           ChecklistKind
  name           String        @db.VarChar(120)
  templateId     String?       @map("template_id") @db.Char(36)
  startedAt      DateTime      @map("started_at") @db.DateTime(3)
  completedAt    DateTime?     @map("completed_at") @db.DateTime(3)

  member OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)
  tasks  ChecklistTask[]

  @@unique([organizationId, id])
  @@index([organizationId, userId, kind])
  @@map("checklists")
}

model ChecklistTask {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  checklistId    String    @map("checklist_id") @db.Char(36)
  sortOrder      Int       @map("sort_order")
  title          String    @db.VarChar(200)
  assigneeRole   String    @map("assignee_role") @db.VarChar(16)
  assigneeId     String?   @map("assignee_id") @db.Char(36)
  dueDate        DateTime? @map("due_date") @db.Date
  doneAt         DateTime? @map("done_at") @db.DateTime(3)
  doneById       String?   @map("done_by_id") @db.Char(36)

  checklist Checklist @relation(fields: [organizationId, checklistId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, assigneeId, doneAt])
  @@map("checklist_tasks")
}

// ─── Custom fields ──────────────────────────────────────────────────────────

enum CustomFieldEntity {
  EMPLOYEE
  PROJECT
  TASK
  CLIENT
  TICKET
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  BOOLEAN
}

model CustomField {
  id             String            @id @default(uuid(7)) @db.Char(36)
  organizationId String            @map("organization_id") @db.Char(36)
  entity         CustomFieldEntity
  key            String            @db.VarChar(48)
  label          String            @db.VarChar(120)
  type           CustomFieldType
  options        Json?
  required       Boolean           @default(false)
  sortOrder      Int               @default(0) @map("sort_order")
  archivedAt     DateTime?         @map("archived_at") @db.DateTime(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  values CustomFieldValue[]

  @@unique([organizationId, id])
  @@unique([organizationId, entity, key])
  @@map("custom_fields")
}

model CustomFieldValue {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  fieldId        String    @map("field_id") @db.Char(36)
  entityId       String    @map("entity_id") @db.Char(36)
  valueText      String?   @map("value_text") @db.VarChar(1000)
  valueNumber    Decimal?  @map("value_number") @db.Decimal(19, 4)
  valueDate      DateTime? @map("value_date") @db.Date
  valueJson      Json?     @map("value_json")
  updatedById    String?   @map("updated_by_id") @db.Char(36)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  field CustomField @relation(fields: [organizationId, fieldId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([organizationId, fieldId, entityId])
  @@index([organizationId, entityId])
  @@index([organizationId, fieldId, valueText(length: 64)])
  @@map("custom_field_values")
}

// ─── Integrations ───────────────────────────────────────────────────────────

/// Outbound webhook. The signing secret is encrypted at rest and shown once at creation.
model Webhook {
  id                  String   @id @default(uuid(7)) @db.Char(36)
  organizationId      String   @map("organization_id") @db.Char(36)
  url                 String   @db.VarChar(2048)
  description         String?  @db.VarChar(200)
  events              Json
  secretEnc           String   @map("secret_enc") @db.Text
  isActive            Boolean  @default(true) @map("is_active")
  consecutiveFailures Int      @default(0) @map("consecutive_failures")
  disabledReason      String?  @map("disabled_reason") @db.VarChar(200)
  createdById         String   @map("created_by_id") @db.Char(36)
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  deliveries WebhookDelivery[]

  @@unique([organizationId, id])
  @@map("webhooks")
}

enum DeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One delivery of one event to one webhook. Retries update the row (attempt, next_retry_at);
/// a manual replay is a new row pointing at the original.
model WebhookDelivery {
  id             String         @id @default(uuid(7)) @db.Char(36)
  organizationId String         @map("organization_id") @db.Char(36)
  webhookId      String         @map("webhook_id") @db.Char(36)
  eventId        String         @map("event_id") @db.Char(36)
  eventType      String         @map("event_type") @db.VarChar(64)
  payload        Json
  /// "{webhookId}:{eventId}" for originals (unique, so fan-out is idempotent); null for replays.
  fanoutKey      String?        @unique @map("fanout_key") @db.VarChar(80)
  replayOfId     String?        @map("replay_of_id") @db.Char(36)
  attempt        Int            @default(0)
  status         DeliveryStatus @default(PENDING)
  statusCode     Int?           @map("status_code")
  responseMs     Int?           @map("response_ms")
  error          String?        @db.VarChar(500)
  nextRetryAt    DateTime?      @map("next_retry_at") @db.DateTime(3)
  deliveredAt    DateTime?      @map("delivered_at") @db.DateTime(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  webhook Webhook @relation(fields: [organizationId, webhookId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, webhookId, createdAt])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

/// API key: "orb_<prefix>_<secret>". Only the SHA-256 of the whole key is stored.
model ApiKey {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  name           String    @db.VarChar(120)
  prefix         String    @unique @db.VarChar(16)
  keyHash        String    @map("key_hash") @db.Char(64)
  scopes         Json
  expiresAt      DateTime? @map("expires_at") @db.DateTime(3)
  lastUsedAt     DateTime? @map("last_used_at") @db.DateTime(3)
  revokedAt      DateTime? @map("revoked_at") @db.DateTime(3)
  createdById    String    @map("created_by_id") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  creator OrganizationMember @relation(fields: [organizationId, createdById], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@map("api_keys")
}

// ─── Notifications ──────────────────────────────────────────────────────────

/// In-app notifications. Persisted in the same transaction as the event that causes them;
/// real-time delivery over Socket.IO is a best-effort hint (clients refetch on reconnect).
model Notification {
  id              String    @id @default(uuid(7)) @db.Char(36)
  organizationId  String    @map("organization_id") @db.Char(36)
  recipientUserId String    @map("recipient_user_id") @db.Char(36)
  type            String    @db.VarChar(64)
  title           String    @db.VarChar(200)
  body            String?   @db.VarChar(1000)
  link            String?   @db.VarChar(500)
  subjectType     String?   @map("subject_type") @db.VarChar(64)
  subjectId       String?   @map("subject_id") @db.Char(36)
  dedupeKey       String    @map("dedupe_key") @db.VarChar(191)
  readAt          DateTime? @map("read_at") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  recipient OrganizationMember @relation(fields: [organizationId, recipientUserId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)

  @@unique([organizationId, recipientUserId, dedupeKey])
  @@index([organizationId, recipientUserId, readAt, createdAt])
  @@map("notifications")
}

/// Per-member channel preferences per notification type. Missing rows mean "use the defaults".
model NotificationPreference {
  organizationId String   @map("organization_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  type           String   @db.VarChar(64)
  inApp          Boolean  @default(true) @map("in_app")
  email          Boolean  @default(false)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  member OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)

  @@id([organizationId, userId, type])
  @@map("notification_preferences")
}

// ─── Platform plumbing ──────────────────────────────────────────────────────

enum AuditActorType {
  USER
  AGENT
  SYSTEM
  API_KEY
  SUPPORT
}

/// Append-only. No foreign keys and a timestamp in the primary key so the table can be
/// range-partitioned by month (MySQL forbids FKs on partitioned tables). See ADR D13.
model AuditLog {
  id             String         @default(uuid(7)) @db.Char(36)
  at             DateTime       @default(now()) @db.DateTime(3)
  organizationId String?        @map("organization_id") @db.Char(36)
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id") @db.Char(36)
  action         String         @db.VarChar(96)
  targetType     String?        @map("target_type") @db.VarChar(64)
  targetId       String?        @map("target_id") @db.Char(36)
  diff           Json?
  ip             String?        @db.VarChar(45)
  userAgent      String?        @map("user_agent") @db.VarChar(512)
  requestId      String?        @map("request_id") @db.VarChar(128)

  @@id([id, at])
  @@index([organizationId, at])
  @@index([organizationId, targetType, targetId])
  @@map("audit_logs")
}

/// Transactional outbox: written in the same transaction as the state change, relayed to
/// BullMQ by the worker (at-least-once; consumers dedupe on dedupe_key).
model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String?   @map("organization_id") @db.Char(36)
  type           String    @db.VarChar(96)
  payload        Json
  dedupeKey      String    @unique @map("dedupe_key") @db.VarChar(191)
  availableAt    DateTime  @default(now()) @map("available_at") @db.DateTime(3)
  publishedAt    DateTime? @map("published_at") @db.DateTime(3)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.VarChar(1000)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([publishedAt, availableAt])
  @@map("outbox_events")
}

/// Stored responses for requests carrying an Idempotency-Key (24 h replay window).
model IdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  key            String   @db.VarChar(128)
  methodPath     String   @map("method_path") @db.VarChar(255)
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int?     @map("response_status") @db.SmallInt
  responseBody   Json?    @map("response_body")
  expiresAt      DateTime @map("expires_at") @db.DateTime(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([organizationId, userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum BackgroundJobStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// Execution record for jobs that must run at most once per idempotency key.
model BackgroundJobRecord {
  id             String              @id @default(uuid(7)) @db.Char(36)
  queue          String              @db.VarChar(64)
  jobId          String?             @map("job_id") @db.VarChar(128)
  name           String              @db.VarChar(96)
  idempotencyKey String              @map("idempotency_key") @db.VarChar(191)
  status         BackgroundJobStatus @default(RUNNING)
  attempts       Int                 @default(1)
  lastError      String?             @map("last_error") @db.VarChar(1000)
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  finishedAt     DateTime?           @map("finished_at") @db.DateTime(3)

  @@unique([queue, idempotencyKey])
  @@map("background_job_records")
}
