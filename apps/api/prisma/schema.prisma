// Orbit database schema (MySQL 8.4).
// Conventions: docs/database-design.md. UUIDv7 keys, UTC DATETIME(3), tenant-owned rows carry
// organization_id plus UNIQUE(organization_id, id) so children can use composite FKs.
// Composite FKs to organization_members use (organization_id, user_id), which guarantees the
// referenced user belongs to the same organization. They use Restrict/Cascade, never SetNull,
// because SetNull would also null the shared organization_id column.

generator client {
  // prisma-client-js emits JavaScript into node_modules (no TypeScript sources in the repo).
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  // Only read by `prisma migrate dev`; lets the app user stay without global CREATE privileges.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─── Identity & organization ────────────────────────────────────────────────

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

model Organization {
  id                String             @id @default(uuid(7)) @db.Char(36)
  name              String             @db.VarChar(160)
  slug              String             @unique @db.VarChar(64)
  timeZone          String             @default("UTC") @map("time_zone") @db.VarChar(64)
  baseCurrency      String             @default("USD") @map("base_currency") @db.Char(3)
  locale            String             @default("en-US") @db.VarChar(16)
  weekStart         Int                @default(1) @map("week_start") @db.TinyInt // ISO weekday, 1 = Monday
  brandColor        String?            @map("brand_color") @db.VarChar(9)
  status            OrganizationStatus @default(TRIAL)
  seatLimit         Int?               @map("seat_limit")
  storageLimitBytes BigInt?            @map("storage_limit_bytes")
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  settings        OrganizationSettings?
  members         OrganizationMember[]
  sessions        UserSession[]
  departments     Department[]
  teams           Team[]
  roles           Role[]
  invitations     Invitation[]
  schedules       WorkSchedule[]
  holidays        Holiday[]
  projects        Project[]
  labels          Label[]
  files           FileObject[]
  capturePolicies CapturePolicy[]

  @@map("organizations")
}

/// Per-organization settings, one JSON document per section (validated by Zod on write).
model OrganizationSettings {
  organizationId String   @id @map("organization_id") @db.Char(36)
  data           Json
  version        Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("organization_settings")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

/// Global login identity. One row per email; organization access comes from memberships.
model User {
  id                String     @id @default(uuid(7)) @db.Char(36)
  email             String     @unique @db.VarChar(254)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.DateTime(3)
  passwordHash      String?    @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.DateTime(3)
  name              String     @db.VarChar(160)
  status            UserStatus @default(ACTIVE)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.DateTime(3)
  lastLoginAt       DateTime?  @map("last_login_at") @db.DateTime(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  memberships OrganizationMember[]
  sessions    UserSession[]
  authTokens  AuthToken[]
  mfa         MfaSetting?

  @@map("users")
}

enum MemberType {
  EMPLOYEE
  CLIENT
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ARCHIVED
}

/// A user's membership in one organization. The membership id is the public "employeeId".
model OrganizationMember {
  id             String       @id @default(uuid(7)) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  userId         String       @map("user_id") @db.Char(36)
  memberType     MemberType   @default(EMPLOYEE) @map("member_type")
  /// Client portal users (member_type CLIENT) belong to exactly one client.
  clientId       String?      @map("client_id") @db.Char(36)
  status         MemberStatus @default(INVITED)
  joinedAt       DateTime?    @map("joined_at") @db.DateTime(3)
  deactivatedAt  DateTime?    @map("deactivated_at") @db.DateTime(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  profile             EmployeeProfile?           @relation("ProfileOwner")
  directReports       EmployeeProfile[]          @relation("ProfileManager")
  managedDepartments  Department[]               @relation("DepartmentManager")
  ledTeams            Team[]                     @relation("TeamLead")
  teamMemberships     TeamMember[]
  roles               MemberRole[]
  permissionOverrides MemberPermissionOverride[]
  invitations         Invitation[]
  changeHistory       ProfileChangeHistory[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  workState           MemberWorkState?
  attendanceRecords   AttendanceRecord[]
  workSessions        WorkSession[]
  timeEntries         TimeEntry[]
  timesheets          Timesheet[]
  correctionsFiled    AttendanceCorrection[]
  managedProjects     Project[]                  @relation("ProjectManager")
  projectMemberships  ProjectMember[]
  taskAssignments     TaskAssignee[]
  calendarInvites     CalendarEventAttendee[]
  consents            MonitoringConsentRecord[]
  pairingCodes        AgentPairingCode[]
  desktopAgents       DesktopAgent[]
  screenshots         Screenshot[]
  dailyStats          DailyMemberStat[]
  reportJobs          ReportJob[]
  client              Client?                    @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  reportedTickets     SupportTicket[]            @relation("TicketReporter")
  expenses            Expense[]
  leaveLedger         LeaveLedgerEntry[]
  leaveRequests       LeaveRequest[]
  employmentDocuments EmploymentDocument[]
  checklists          Checklist[]
  apiKeys             ApiKey[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([userId])
  @@map("organization_members")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

/// HR profile for an employee membership. personal_email, address and emergency_contact are
/// encrypted by the application (AES-256-GCM) before they reach the database.
model EmployeeProfile {
  id                  String          @id @default(uuid(7)) @db.Char(36)
  organizationId      String          @map("organization_id") @db.Char(36)
  userId              String          @map("user_id") @db.Char(36)
  employeeCode        String?         @map("employee_code") @db.VarChar(32)
  designation         String?         @db.VarChar(120)
  departmentId        String?         @map("department_id") @db.Char(36)
  managerUserId       String?         @map("manager_user_id") @db.Char(36)
  employmentType      EmploymentType? @map("employment_type")
  joiningDate         DateTime?       @map("joining_date") @db.Date
  probationEndDate    DateTime?       @map("probation_end_date") @db.Date
  noticePeriodDays    Int?            @map("notice_period_days") @db.SmallInt
  lastWorkingDate     DateTime?       @map("last_working_date") @db.Date
  workLocation        String?         @map("work_location") @db.VarChar(120)
  timeZone            String?         @map("time_zone") @db.VarChar(64)
  phone               String?         @db.VarChar(32)
  personalEmailEnc    String?         @map("personal_email_enc") @db.Text
  addressEnc          String?         @map("address_enc") @db.Text
  emergencyContactEnc String?         @map("emergency_contact_enc") @db.Text
  skills              Json?
  completionPct       Int             @default(0) @map("completion_pct") @db.TinyInt
  createdAt           DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  member     OrganizationMember  @relation("ProfileOwner", fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)
  department Department?         @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  manager    OrganizationMember? @relation("ProfileManager", fields: [organizationId, managerUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, userId])
  @@unique([organizationId, employeeCode])
  @@index([organizationId, departmentId])
  @@index([organizationId, managerUserId])
  @@map("employee_profiles")
}

/// Field-level change history for employee profiles. Sensitive values are stored redacted.
model ProfileChangeHistory {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  field          String   @db.VarChar(64)
  oldValue       String?  @map("old_value") @db.Text
  newValue       String?  @map("new_value") @db.Text
  changedById    String?  @map("changed_by_id") @db.Char(36)
  requestId      String?  @map("request_id") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  member OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId, userId, createdAt])
  @@map("profile_change_history")
}

model Department {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  name           String    @db.VarChar(120)
  code           String    @db.VarChar(32)
  parentId       String?   @map("parent_id") @db.Char(36)
  managerUserId  String?   @map("manager_user_id") @db.Char(36)
  archivedAt     DateTime? @map("archived_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       Department?         @relation("DepartmentTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  children     Department[]        @relation("DepartmentTree")
  manager      OrganizationMember? @relation("DepartmentManager", fields: [organizationId, managerUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  teams        Team[]
  profiles     EmployeeProfile[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, parentId])
  @@map("departments")
}

model Team {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  name           String    @db.VarChar(120)
  departmentId   String?   @map("department_id") @db.Char(36)
  leadUserId     String?   @map("lead_user_id") @db.Char(36)
  archivedAt     DateTime? @map("archived_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department   Department?         @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lead         OrganizationMember? @relation("TeamLead", fields: [organizationId, leadUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  members      TeamMember[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, leadUserId])
  @@map("teams")
}

model TeamMember {
  organizationId String   @map("organization_id") @db.Char(36)
  teamId         String   @map("team_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  team   Team               @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  member OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)

  @@id([teamId, userId])
  @@index([organizationId, userId])
  @@map("team_members")
}

// ─── Access control ─────────────────────────────────────────────────────────

enum PermissionScope {
  SELF
  TEAM
  DEPARTMENT
  PROJECT
  ORG
}

/// Global permission catalog, synced from src/modules/rbac/permission-catalog.js.
model Permission {
  key           String @id @db.VarChar(96)
  module        String @db.VarChar(48)
  description   String @db.VarChar(255)
  allowedScopes Json   @map("allowed_scopes")

  rolePermissions RolePermission[]
  overrides       MemberPermissionOverride[]

  @@map("permissions")
}

/// Roles are per organization. System roles are created from code templates when an
/// organization is created; organizations may edit them (except OWNER) or add custom roles.
model Role {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  key            String   @db.VarChar(64)
  name           String   @db.VarChar(120)
  description    String?  @db.VarChar(500)
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  members      MemberRole[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@map("roles")
}

model RolePermission {
  organizationId String          @map("organization_id") @db.Char(36)
  roleId         String          @map("role_id") @db.Char(36)
  permissionKey  String          @map("permission_key") @db.VarChar(96)
  scope          PermissionScope

  role       Role       @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([organizationId])
  @@map("role_permissions")
}

model MemberRole {
  organizationId String   @map("organization_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  roleId         String   @map("role_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  member OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)
  role   Role               @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, userId, roleId])
  @@index([organizationId, roleId])
  @@map("member_roles")
}

/// Deny-only overrides: they can remove a permission from a member, never add one.
model MemberPermissionOverride {
  organizationId String   @map("organization_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  permissionKey  String   @map("permission_key") @db.VarChar(96)
  reason         String?  @db.VarChar(500)
  createdById    String?  @map("created_by_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  member     OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)
  permission Permission         @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([organizationId, userId, permissionKey])
  @@map("member_permission_overrides")
}

// ─── Authentication ─────────────────────────────────────────────────────────

/// Pending invitation for a membership in status INVITED. Only the token's SHA-256 is stored.
model Invitation {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  userId         String    @map("user_id") @db.Char(36)
  email          String    @db.VarChar(254)
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at") @db.DateTime(3)
  acceptedAt     DateTime? @map("accepted_at") @db.DateTime(3)
  revokedAt      DateTime? @map("revoked_at") @db.DateTime(3)
  invitedById    String?   @map("invited_by_id") @db.Char(36)
  sendCount      Int       @default(1) @map("send_count")
  lastSentAt     DateTime  @default(now()) @map("last_sent_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member       OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, email])
  @@index([organizationId, userId])
  @@map("invitations")
}

/// Opaque web sessions. Only the SHA-256 of the cookie token is stored.
model UserSession {
  id                   String    @id @default(uuid(7)) @db.Char(36)
  userId               String    @map("user_id") @db.Char(36)
  activeOrganizationId String?   @map("active_organization_id") @db.Char(36)
  tokenHash            String    @unique @map("token_hash") @db.Char(64)
  ip                   String?   @db.VarChar(45)
  userAgent            String?   @map("user_agent") @db.VarChar(512)
  deviceLabel          String?   @map("device_label") @db.VarChar(120)
  mfaRequired          Boolean   @default(false) @map("mfa_required")
  mfaVerifiedAt        DateTime? @map("mfa_verified_at") @db.DateTime(3)
  lastSeenAt           DateTime  @default(now()) @map("last_seen_at") @db.DateTime(3)
  expiresAt            DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt            DateTime? @map("revoked_at") @db.DateTime(3)
  revokeReason         String?   @map("revoke_reason") @db.VarChar(64)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([activeOrganizationId, userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

enum AuthTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Single-use email tokens. Only the SHA-256 is stored.
model AuthToken {
  id        String           @id @default(uuid(7)) @db.Char(36)
  userId    String           @map("user_id") @db.Char(36)
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime         @map("expires_at") @db.DateTime(3)
  usedAt    DateTime?        @map("used_at") @db.DateTime(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

/// TOTP MFA. Secrets are encrypted; recovery codes are stored as SHA-256 hashes.
model MfaSetting {
  userId             String    @id @map("user_id") @db.Char(36)
  secretEnc          String?   @map("secret_enc") @db.Text
  pendingSecretEnc   String?   @map("pending_secret_enc") @db.Text
  enabledAt          DateTime? @map("enabled_at") @db.DateTime(3)
  recoveryCodeHashes Json?     @map("recovery_code_hashes")
  lastUsedStep       BigInt?   @map("last_used_step")
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_settings")
}

/// Append-only login telemetry (partition-ready: no FKs, timestamp in the primary key).
model LoginAttempt {
  id        String   @default(uuid(7)) @db.Char(36)
  at        DateTime @default(now()) @db.DateTime(3)
  emailHash String   @map("email_hash") @db.Char(64)
  ip        String?  @db.VarChar(45)
  success   Boolean
  reason    String   @db.VarChar(32)

  @@id([id, at])
  @@index([emailHash, at])
  @@index([ip, at])
  @@map("login_attempts")
}

// ─── Attendance & time ──────────────────────────────────────────────────────

enum ScheduleType {
  FIXED
  FLEXIBLE
}

/// Weekly schedule in local wall-clock time. days: [{ weekday: 1-7, start: "09:00", end: "18:00" }].
/// An end at or before the start means the shift ends the next day (overnight).
model WorkSchedule {
  id                    String       @id @default(uuid(7)) @db.Char(36)
  organizationId        String       @map("organization_id") @db.Char(36)
  name                  String       @db.VarChar(120)
  type                  ScheduleType @default(FIXED)
  timeZone              String?      @map("time_zone") @db.VarChar(64) // null = the member's zone
  days                  Json
  requiredMinutesPerDay Int?         @map("required_minutes_per_day") @db.SmallInt
  isDefault             Boolean      @default(false) @map("is_default")
  archivedAt            DateTime?    @map("archived_at") @db.DateTime(3)
  createdAt             DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments  ScheduleAssignment[]
  slaPolicies  SlaPolicy[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("work_schedules")
}

enum ScheduleTarget {
  DEPARTMENT
  TEAM
  MEMBER
}

/// Precedence: MEMBER > TEAM > DEPARTMENT > the organization's default schedule.
model ScheduleAssignment {
  id             String         @id @default(uuid(7)) @db.Char(36)
  organizationId String         @map("organization_id") @db.Char(36)
  scheduleId     String         @map("schedule_id") @db.Char(36)
  targetType     ScheduleTarget @map("target_type")
  targetId       String         @map("target_id") @db.Char(36)
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  schedule WorkSchedule @relation(fields: [organizationId, scheduleId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([organizationId, targetType, targetId])
  @@map("schedule_assignments")
}

model Holiday {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  date           DateTime @db.Date
  name           String   @db.VarChar(120)
  isHalfDay      Boolean  @default(false) @map("is_half_day")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, date])
  @@map("holidays")
}

enum WorkState {
  OFF
  WORKING
  ON_BREAK
}

enum TimerState {
  NONE
  RUNNING
  PAUSED
}

/// One row per member: the serialization point for every clock, break and timer transition
/// (ADR D5). Transitions lock this row FOR UPDATE, so concurrent requests cannot double-clock.
model MemberWorkState {
  organizationId String     @map("organization_id") @db.Char(36)
  userId         String     @map("user_id") @db.Char(36)
  state          WorkState  @default(OFF)
  workSessionId  String?    @map("work_session_id") @db.Char(36)
  breakSessionId String?    @map("break_session_id") @db.Char(36)
  timerState     TimerState @default(NONE) @map("timer_state")
  timeEntryId    String?    @map("time_entry_id") @db.Char(36)
  timerContext   Json?      @map("timer_context")
  lastActivityAt DateTime?  @map("last_activity_at") @db.DateTime(3)
  version        Int        @default(0)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  member OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)

  @@id([organizationId, userId])
  @@index([organizationId, state])
  @@map("member_work_states")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HOLIDAY
  LEAVE
}

/// Daily summary per member. work_date is the local date (member time zone) on which the first
/// session of the day started; overnight sessions belong to the day they started.
model AttendanceRecord {
  id               String           @id @default(uuid(7)) @db.Char(36)
  organizationId   String           @map("organization_id") @db.Char(36)
  userId           String           @map("user_id") @db.Char(36)
  workDate         DateTime         @map("work_date") @db.Date
  status           AttendanceStatus @default(PRESENT)
  timeZone         String           @map("time_zone") @db.VarChar(64)
  firstInAt        DateTime?        @map("first_in_at") @db.DateTime(3)
  lastOutAt        DateTime?        @map("last_out_at") @db.DateTime(3)
  workedS          Int              @default(0) @map("worked_s")
  breakS           Int              @default(0) @map("break_s")
  lateByS          Int              @default(0) @map("late_by_s")
  earlyByS         Int              @default(0) @map("early_by_s")
  overtimeS        Int              @default(0) @map("overtime_s")
  flags            Json
  scheduleSnapshot Json?            @map("schedule_snapshot")
  createdAt        DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  member      OrganizationMember     @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)
  sessions    WorkSession[]
  corrections AttendanceCorrection[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId, workDate])
  @@index([organizationId, workDate, status])
  @@map("attendance_records")
}

enum SessionEndReason {
  CLOCK_OUT
  AUTO_CLOSED
  CORRECTION
}

enum SessionSource {
  WEB
  AGENT
  CORRECTION
}

model WorkSession {
  id                 String            @id @default(uuid(7)) @db.Char(36)
  organizationId     String            @map("organization_id") @db.Char(36)
  userId             String            @map("user_id") @db.Char(36)
  attendanceRecordId String            @map("attendance_record_id") @db.Char(36)
  startedAt          DateTime          @map("started_at") @db.DateTime(3)
  endedAt            DateTime?         @map("ended_at") @db.DateTime(3)
  endReason          SessionEndReason? @map("end_reason")
  source             SessionSource     @default(WEB)
  note               String?           @db.VarChar(280)
  createdAt          DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  member  OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)
  record  AttendanceRecord   @relation(fields: [organizationId, attendanceRecordId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  breaks  BreakSession[]
  entries TimeEntry[]

  @@unique([organizationId, id])
  @@index([organizationId, userId, startedAt])
  @@index([organizationId, endedAt])
  @@map("work_sessions")
}

model BreakSession {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  workSessionId  String    @map("work_session_id") @db.Char(36)
  startedAt      DateTime  @map("started_at") @db.DateTime(3)
  endedAt        DateTime? @map("ended_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  session WorkSession @relation(fields: [organizationId, workSessionId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId, workSessionId])
  @@map("break_sessions")
}

enum CorrectionKind {
  ADD
  MODIFY
  DELETE
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Requests to add, change or remove a work session. Approval applies the change; the original
/// session times are kept in `original` so the history is never lost.
model AttendanceCorrection {
  id                 String           @id @default(uuid(7)) @db.Char(36)
  organizationId     String           @map("organization_id") @db.Char(36)
  userId             String           @map("user_id") @db.Char(36)
  attendanceRecordId String?          @map("attendance_record_id") @db.Char(36)
  workDate           DateTime         @map("work_date") @db.Date
  kind               CorrectionKind
  workSessionId      String?          @map("work_session_id") @db.Char(36)
  proposedStartAt    DateTime?        @map("proposed_start_at") @db.DateTime(3)
  proposedEndAt      DateTime?        @map("proposed_end_at") @db.DateTime(3)
  original           Json?
  reason             String           @db.VarChar(500)
  status             CorrectionStatus @default(PENDING)
  reviewedById       String?          @map("reviewed_by_id") @db.Char(36)
  reviewedAt         DateTime?        @map("reviewed_at") @db.DateTime(3)
  reviewComment      String?          @map("review_comment") @db.VarChar(500)
  createdAt          DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  member OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)
  record AttendanceRecord?  @relation(fields: [organizationId, attendanceRecordId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, userId, createdAt])
  @@map("attendance_corrections")
}

enum TimeEntrySource {
  TIMER
  MANUAL
}

/// A tracked interval. ended_at NULL marks the running timer segment.
model TimeEntry {
  id             String          @id @default(uuid(7)) @db.Char(36)
  organizationId String          @map("organization_id") @db.Char(36)
  userId         String          @map("user_id") @db.Char(36)
  workSessionId  String?         @map("work_session_id") @db.Char(36)
  projectId      String?         @map("project_id") @db.Char(36)
  taskId         String?         @map("task_id") @db.Char(36)
  description    String?         @db.VarChar(500)
  isBillable     Boolean         @default(false) @map("is_billable")
  startedAt      DateTime        @map("started_at") @db.DateTime(3)
  endedAt        DateTime?       @map("ended_at") @db.DateTime(3)
  durationS      Int             @default(0) @map("duration_s")
  source         TimeEntrySource @default(TIMER)
  lockedAt       DateTime?       @map("locked_at") @db.DateTime(3)
  deletedAt      DateTime?       @map("deleted_at") @db.DateTime(3)
  version        Int             @default(0)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  member      OrganizationMember    @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)
  session     WorkSession?          @relation(fields: [organizationId, workSessionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  project     Project?              @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  task        Task?                 @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  revisions   TimeEntryRevision[]
  timesheet   TimesheetEntry?
  invoiceLink InvoiceItemTimeEntry?

  @@unique([organizationId, id])
  @@index([organizationId, userId, startedAt])
  @@index([organizationId, projectId, startedAt])
  @@index([organizationId, taskId])
  // Organization-wide ranges (dashboard "tracked today"); found by the Phase 11 load test.
  @@index([organizationId, startedAt])
  @@map("time_entries")
}

model TimeEntryRevision {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  timeEntryId    String   @map("time_entry_id") @db.Char(36)
  revisionNo     Int      @map("revision_no")
  before         Json?
  after          Json?
  reason         String?  @db.VarChar(500)
  changedById    String   @map("changed_by_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  entry TimeEntry @relation(fields: [organizationId, timeEntryId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([timeEntryId, revisionNo])
  @@map("time_entry_revisions")
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model Timesheet {
  id             String          @id @default(uuid(7)) @db.Char(36)
  organizationId String          @map("organization_id") @db.Char(36)
  userId         String          @map("user_id") @db.Char(36)
  periodStart    DateTime        @map("period_start") @db.Date
  periodEnd      DateTime        @map("period_end") @db.Date
  status         TimesheetStatus @default(DRAFT)
  totalS         Int             @default(0) @map("total_s")
  billableS      Int             @default(0) @map("billable_s")
  submittedAt    DateTime?       @map("submitted_at") @db.DateTime(3)
  decidedAt      DateTime?       @map("decided_at") @db.DateTime(3)
  decidedById    String?         @map("decided_by_id") @db.Char(36)
  version        Int             @default(0)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  member    OrganizationMember  @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)
  entries   TimesheetEntry[]
  approvals TimesheetApproval[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId, periodStart])
  @@index([organizationId, status, periodStart])
  @@map("timesheets")
}

/// Links entries to a timesheet. UNIQUE(organization_id, time_entry_id): an entry is counted in
/// at most one timesheet, so hours can never be double-counted.
model TimesheetEntry {
  organizationId String @map("organization_id") @db.Char(36)
  timesheetId    String @map("timesheet_id") @db.Char(36)
  timeEntryId    String @map("time_entry_id") @db.Char(36)

  timesheet Timesheet @relation(fields: [organizationId, timesheetId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  entry     TimeEntry @relation(fields: [organizationId, timeEntryId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@id([timesheetId, timeEntryId])
  @@unique([organizationId, timeEntryId])
  @@map("timesheet_entries")
}

enum TimesheetAction {
  SUBMIT
  APPROVE
  REJECT
  REOPEN
}

/// Append-only decision history (UPDATE/DELETE blocked by triggers).
model TimesheetApproval {
  id             String          @id @default(uuid(7)) @db.Char(36)
  organizationId String          @map("organization_id") @db.Char(36)
  timesheetId    String          @map("timesheet_id") @db.Char(36)
  action         TimesheetAction
  actorId        String          @map("actor_id") @db.Char(36)
  comment        String?         @db.VarChar(2000)
  snapshot       Json
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  timesheet Timesheet @relation(fields: [organizationId, timesheetId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId, timesheetId, createdAt])
  @@map("timesheet_approvals")
}

// ─── Projects & tasks ───────────────────────────────────────────────────────

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectVisibility {
  PRIVATE
  ORG
}

/// client_id gains a foreign key when the CRM's clients table arrives (Phase 9).
model Project {
  id                String            @id @default(uuid(7)) @db.Char(36)
  organizationId    String            @map("organization_id") @db.Char(36)
  code              String            @db.VarChar(32)
  name              String            @db.VarChar(160)
  description       String?           @db.Text
  clientId          String?           @map("client_id") @db.Char(36)
  /// Shown (status and milestones only) to the client's portal users.
  sharedWithClient  Boolean           @default(false) @map("shared_with_client")
  managerUserId     String?           @map("manager_user_id") @db.Char(36)
  status            ProjectStatus     @default(PLANNED)
  priority          Priority          @default(MEDIUM)
  visibility        ProjectVisibility @default(PRIVATE)
  startDate         DateTime?         @map("start_date") @db.Date
  endDate           DateTime?         @map("end_date") @db.Date
  deadline          DateTime?         @db.Date
  budgetAmount      Decimal?          @map("budget_amount") @db.Decimal(19, 4)
  budgetCurrency    String?           @map("budget_currency") @db.Char(3)
  estimatedS        Int?              @map("estimated_s")
  isBillableDefault Boolean           @default(true) @map("is_billable_default")
  nextTaskNumber    Int               @default(1) @map("next_task_number")
  closedAt          DateTime?         @map("closed_at") @db.DateTime(3)
  archivedAt        DateTime?         @map("archived_at") @db.DateTime(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client?             @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  manager      OrganizationMember? @relation("ProjectManager", fields: [organizationId, managerUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  members      ProjectMember[]
  milestones   Milestone[]
  statuses     TaskStatus[]
  tasks        Task[]
  timeEntries  TimeEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status, archivedAt])
  @@index([organizationId, managerUserId])
  @@map("projects")
}

enum ProjectRole {
  MANAGER
  MEMBER
  VIEWER
}

model ProjectMember {
  organizationId String      @map("organization_id") @db.Char(36)
  projectId      String      @map("project_id") @db.Char(36)
  userId         String      @map("user_id") @db.Char(36)
  role           ProjectRole @default(MEMBER)
  createdAt      DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  project Project            @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  member  OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)

  @@id([projectId, userId])
  @@index([organizationId, userId])
  @@map("project_members")
}

model Milestone {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  projectId      String    @map("project_id") @db.Char(36)
  name           String    @db.VarChar(160)
  dueDate        DateTime? @map("due_date") @db.Date
  completedAt    DateTime? @map("completed_at") @db.DateTime(3)
  sort           Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  project Project @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  tasks   Task[]

  @@unique([organizationId, id])
  @@index([organizationId, projectId, dueDate])
  @@map("milestones")
}

enum StatusCategory {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Per-project workflow columns. The category drives behaviour (DONE sets completed_at).
model TaskStatus {
  id             String         @id @default(uuid(7)) @db.Char(36)
  organizationId String         @map("organization_id") @db.Char(36)
  projectId      String         @map("project_id") @db.Char(36)
  name           String         @db.VarChar(60)
  category       StatusCategory
  sort           Int            @default(0)

  project Project @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  tasks   Task[]

  @@unique([organizationId, id])
  @@unique([projectId, name])
  @@map("task_statuses")
}

model Task {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  projectId      String    @map("project_id") @db.Char(36)
  number         Int
  parentId       String?   @map("parent_id") @db.Char(36)
  milestoneId    String?   @map("milestone_id") @db.Char(36)
  statusId       String    @map("status_id") @db.Char(36)
  title          String    @db.VarChar(300)
  description    String?   @db.Text
  priority       Priority  @default(MEDIUM)
  startDate      DateTime? @map("start_date") @db.Date
  dueDate        DateTime? @map("due_date") @db.Date
  estimatedS     Int?      @map("estimated_s")
  recurrence     Json?
  sort           Float     @default(0)
  completedAt    DateTime? @map("completed_at") @db.DateTime(3)
  archivedAt     DateTime? @map("archived_at") @db.DateTime(3)
  createdById    String?   @map("created_by_id") @db.Char(36)
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  project      Project              @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  parent       Task?                @relation("Subtasks", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  subtasks     Task[]               @relation("Subtasks")
  milestone    Milestone?           @relation(fields: [organizationId, milestoneId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  status       TaskStatus           @relation(fields: [organizationId, statusId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  assignees    TaskAssignee[]
  checklist    TaskChecklistItem[]
  labels       TaskLabel[]
  comments     TaskComment[]
  attachments  TaskAttachment[]
  receipts     Expense[]
  hrDocuments  EmploymentDocument[]
  dependencies TaskDependency[]     @relation("DependentTask")
  dependents   TaskDependency[]     @relation("BlockingTask")
  events       TaskEvent[]
  timeEntries  TimeEntry[]

  @@unique([organizationId, id])
  @@unique([projectId, number])
  @@index([organizationId, projectId, statusId, sort])
  @@index([organizationId, dueDate])
  @@index([organizationId, parentId])
  @@map("tasks")
}

model TaskAssignee {
  organizationId String   @map("organization_id") @db.Char(36)
  taskId         String   @map("task_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  task   Task               @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  member OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)

  @@id([taskId, userId])
  @@index([organizationId, userId])
  @@map("task_assignees")
}

model TaskChecklistItem {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  taskId         String    @map("task_id") @db.Char(36)
  text           String    @db.VarChar(300)
  doneAt         DateTime? @map("done_at") @db.DateTime(3)
  sort           Int       @default(0)

  task Task @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId, taskId])
  @@map("task_checklist_items")
}

model Label {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  name           String   @db.VarChar(60)
  color          String   @default("#6D4AE0") @db.VarChar(9)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tasks        TaskLabel[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("labels")
}

model TaskLabel {
  organizationId String @map("organization_id") @db.Char(36)
  taskId         String @map("task_id") @db.Char(36)
  labelId        String @map("label_id") @db.Char(36)

  task  Task  @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  label Label @relation(fields: [organizationId, labelId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@id([taskId, labelId])
  @@map("task_labels")
}

model TaskComment {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  taskId         String    @map("task_id") @db.Char(36)
  authorId       String    @map("author_id") @db.Char(36)
  body           String    @db.Text
  editedAt       DateTime? @map("edited_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  task Task @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId, taskId, createdAt])
  @@map("task_comments")
}

/// "task depends on depends_on_task" (finish-to-start). Cycles are rejected by the service.
model TaskDependency {
  organizationId  String   @map("organization_id") @db.Char(36)
  taskId          String   @map("task_id") @db.Char(36)
  dependsOnTaskId String   @map("depends_on_task_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  task      Task @relation("DependentTask", fields: [organizationId, taskId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  dependsOn Task @relation("BlockingTask", fields: [organizationId, dependsOnTaskId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@id([taskId, dependsOnTaskId])
  @@index([organizationId, dependsOnTaskId])
  @@map("task_dependencies")
}

/// Task activity history: one row per meaningful change (status, assignees, fields, comments).
model TaskEvent {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  taskId         String   @map("task_id") @db.Char(36)
  actorId        String?  @map("actor_id") @db.Char(36)
  type           String   @db.VarChar(48)
  data           Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  task Task @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId, taskId, createdAt])
  @@map("task_events")
}

enum FileStatus {
  PENDING
  READY
  DELETED
}

/// Metadata for files in private object storage. Binaries never touch MySQL.
model FileObject {
  id             String     @id @default(uuid(7)) @db.Char(36)
  organizationId String     @map("organization_id") @db.Char(36)
  storageKey     String     @unique @map("storage_key") @db.VarChar(300)
  originalName   String     @map("original_name") @db.VarChar(255)
  mimeType       String     @map("mime_type") @db.VarChar(127)
  sizeBytes      Int        @map("size_bytes")
  purpose        String     @db.VarChar(48)
  status         FileStatus @default(PENDING)
  uploadedById   String     @map("uploaded_by_id") @db.Char(36)
  createdAt      DateTime   @default(now()) @map("created_at") @db.DateTime(3)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  attachments         TaskAttachment[]
  expenses            Expense[]
  employmentDocuments EmploymentDocument[]

  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@map("file_objects")
}

model TaskAttachment {
  organizationId String   @map("organization_id") @db.Char(36)
  taskId         String   @map("task_id") @db.Char(36)
  fileId         String   @map("file_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  task Task       @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  file FileObject @relation(fields: [organizationId, fileId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@id([taskId, fileId])
  @@map("task_attachments")
}

// ─── Calendar ───────────────────────────────────────────────────────────────

/// Meetings created in Orbit. Other calendar entries (holidays, milestones, task deadlines)
/// are read from their own tables.
model CalendarEvent {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  title          String    @db.VarChar(200)
  description    String?   @db.Text
  startAt        DateTime  @map("start_at") @db.DateTime(3)
  endAt          DateTime  @map("end_at") @db.DateTime(3)
  allDay         Boolean   @default(false) @map("all_day")
  location       String?   @db.VarChar(200)
  projectId      String?   @map("project_id") @db.Char(36)
  createdById    String    @map("created_by_id") @db.Char(36)
  cancelledAt    DateTime? @map("cancelled_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

