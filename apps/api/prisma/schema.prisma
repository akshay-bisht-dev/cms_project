enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  RESOLVED
  CLOSED
}

model SupportTicket {
  id                    String         @id @default(uuid(7)) @db.Char(36)
  organizationId        String         @map("organization_id") @db.Char(36)
  number                Int
  clientId              String?        @map("client_id") @db.Char(36)
  projectId             String?        @map("project_id") @db.Char(36)
  reporterId            String         @map("reporter_id") @db.Char(36)
  subject               String         @db.VarChar(200)
  description           String         @db.Text
  priority              TicketPriority @default(NORMAL)
  status                TicketStatus   @default(OPEN)
  teamId                String?        @map("team_id") @db.Char(36)
  assigneeId            String?        @map("assignee_id") @db.Char(36)
  slaPolicyId           String?        @map("sla_policy_id") @db.Char(36)
  firstResponseDueAt    DateTime?      @map("first_response_due_at") @db.DateTime(3)
  resolutionDueAt       DateTime?      @map("resolution_due_at") @db.DateTime(3)
  firstRespondedAt      DateTime?      @map("first_responded_at") @db.DateTime(3)
  resolvedAt            DateTime?      @map("resolved_at") @db.DateTime(3)
  closedAt              DateTime?      @map("closed_at") @db.DateTime(3)
  firstResponseBreached Boolean        @default(false) @map("first_response_breached")
