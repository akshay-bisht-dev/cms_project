}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}

model Quote {
  id             String      @id @default(uuid(7)) @db.Char(36)
  organizationId String      @map("organization_id") @db.Char(36)
  clientId       String      @map("client_id") @db.Char(36)
  opportunityId  String?     @map("opportunity_id") @db.Char(36)
  number         String      @db.VarChar(32)
  version        Int         @default(1)
  status         QuoteStatus @default(DRAFT)
  title          String      @db.VarChar(200)
