  @@unique([organizationId, id])
  @@index([organizationId, status, ownerId])
  @@index([organizationId, followUpAt])
  @@index([organizationId, createdAt])
  @@map("leads")
}

model PipelineStage {
  id                 String    @id @default(uuid(7)) @db.Char(36)
  organizationId     String    @map("organization_id") @db.Char(36)
  name               String    @db.VarChar(80)
  sortOrder          Int       @map("sort_order")
  defaultProbability Int       @map("default_probability") @db.SmallInt
  isWon              Boolean   @default(false) @map("is_won")
  isLost             Boolean   @default(false) @map("is_lost")
  archivedAt         DateTime? @map("archived_at") @db.DateTime(3)

  opportunities Opportunity[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("pipeline_stages")
}

model Opportunity {
  id                String    @id @default(uuid(7)) @db.Char(36)
  organizationId    String    @map("organization_id") @db.Char(36)
  clientId          String?   @map("client_id") @db.Char(36)
  leadId            String?   @map("lead_id") @db.Char(36)
  name              String    @db.VarChar(200)
  stageId           String    @map("stage_id") @db.Char(36)
  value             Decimal   @db.Decimal(19, 4)
  currency          String    @db.Char(3)
  probability       Int       @db.SmallInt
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  ownerId           String?   @map("owner_id") @db.Char(36)
  closedAt          DateTime? @map("closed_at") @db.DateTime(3)
