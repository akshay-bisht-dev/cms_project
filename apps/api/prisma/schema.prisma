  subtotal       Decimal     @default(0) @db.Decimal(19, 4)
  taxTotal       Decimal     @default(0) @map("tax_total") @db.Decimal(19, 4)
  total          Decimal     @default(0) @db.Decimal(19, 4)
  notes          String?     @db.Text
  sentAt         DateTime?   @map("sent_at") @db.DateTime(3)
  decidedAt      DateTime?   @map("decided_at") @db.DateTime(3)
  createdById    String      @map("created_by_id") @db.Char(36)
  createdAt      DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  client      Client       @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
