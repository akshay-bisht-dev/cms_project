  version           Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  client Client?       @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  stage  PipelineStage @relation(fields: [organizationId, stageId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  quotes Quote[]

  @@unique([organizationId, id])
  @@index([organizationId, stageId])
  @@index([organizationId, expectedCloseDate])
  @@map("opportunities")
}

enum SalesSubject {
