[mysqld]
default-time-zone = '+00:00'
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
transaction-isolation = REPEATABLE-READ
sql-mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION,ONLY_FULL_GROUP_BY
max_connections = 300
innodb_lock_wait_timeout = 10
# Binary logs enable point-in-time recovery (docs/backup-recovery.md).
log_bin = mysql-bin
binlog_expire_logs_seconds = 604800
# Triggers created by the migration user without SUPER while binary logging is on.
log_bin_trust_function_creators = 1
